(
 ;; --- Task ---
 ;; Captures go to the inbox undated. Add SCHEDULED/DEADLINE during review
 ;; with C-c C-s / C-c C-d from the entry.
 ("t" "TODO" entry
      (file+headline "tasks.org" "Tasks to be reviewed")
      "* TODO %^{Title}\n:PROPERTIES:\n:CAPTURED: %U\n:END:\n\n%i%l%?"
      :empty-lines-after 1)

 ;; --- Meeting notes (file stays in for_review/) ---
 ("m" "Meeting notes" entry
      (file+headline "for_review/meetings.org" "Meetings")
      "* %^{Title} %t\n:PROPERTIES:\n:RELATED_PROJECT: %^{Project}\n:ATTENDEES: %^{Attendees}\n:END:\n\n%?"
      :prepend t :empty-lines-after 1)

 ;; --- Snippet / trick (file stays in for_review/) ---
 ("s" "Snippet / trick" entry
      (file+headline "for_review/snippets.org" "💾 Snippets")
      "* %?\t%^g\n#+begin_src %^{language}\n\n#+end_src")

 ;; --- Event ---
 ("e" "Event" entry
      (file+headline "events.org" "Events")
      "* %^{Event Title}\n%^T\n%?"
      :empty-lines 1)

 )
