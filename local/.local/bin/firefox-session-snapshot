#!/usr/bin/env python3
"""
firefox-session-snapshot — keep dated copies of the Firefox session.

Firefox keeps only a few session files (sessionstore.jsonlz4 and the files in
sessionstore-backups/) and overwrites them every few seconds.  After a closed
window or a bad restart, the good state is gone within minutes.  This copies
the newest session file of each profile to

    ~/.local/state/firefox-sessions/<profile>/YYYYMMDD-HHMM.jsonlz4

and writes tabs.org next to it: one heading per window, one link per tab.
A copy is skipped when the session did not change.  Copies older than
KEEP_DAYS are deleted, but the newest one is always kept.

Run by firefox-session-snapshot.timer every 15 minutes.

To restore a snapshot: quit Firefox, then copy it over the live file and
start Firefox again (History > Restore Previous Session if it does not
restore by itself):

    cp ~/.local/state/firefox-sessions/<profile>/<time>.jsonlz4 \
       ~/.mozilla/firefox/<profile>/sessionstore.jsonlz4

Needs python3-lz4 (Debian package).
"""

import json
import shutil
import time
from pathlib import Path

import lz4.block

KEEP_DAYS = 7
FIREFOX_DIR = Path.home() / ".mozilla/firefox"
OUT_DIR = Path.home() / ".local/state/firefox-sessions"


def read_session(path):
    data = path.read_bytes()
    # mozlz4: 8-byte magic, then an lz4 block with its size header.
    return json.loads(lz4.block.decompress(data[8:]))


def current_entry(tab):
    entries = tab.get("entries") or [{}]
    return entries[min(max(tab.get("index", len(entries)) - 1, 0), len(entries) - 1)]


def org_link(entry):
    url = entry.get("url", "").replace("[", "%5B").replace("]", "%5D")
    title = entry.get("title") or url
    title = title.replace("[", "(").replace("]", ")")
    return f"[[{url}][{title}]]"


def write_org(session, path, source):
    lines = [f"#+title: Firefox tabs, {time.strftime('%Y-%m-%d %H:%M')}", f"# From {source}", ""]
    for label, windows in [("Window", session.get("windows", [])),
                           ("Closed window", session.get("_closedWindows", []))]:
        for i, window in enumerate(windows, 1):
            lines.append(f"* {label} {i} ({len(window['tabs'])} tabs)")
            lines += [f"** {org_link(current_entry(tab))}" for tab in window["tabs"]]
    path.write_text("\n".join(lines) + "\n")


def snapshot(profile):
    candidates = [profile / "sessionstore.jsonlz4",
                  profile / "sessionstore-backups/recovery.jsonlz4"]
    candidates = [p for p in candidates if p.exists()]
    if not candidates:
        return
    source = max(candidates, key=lambda p: p.stat().st_mtime)
    data = source.read_bytes()

    out = OUT_DIR / profile.name
    out.mkdir(parents=True, exist_ok=True)
    snaps = sorted(out.glob("*.jsonlz4"))
    if not snaps or snaps[-1].read_bytes() != data:
        new = out / time.strftime("%Y%m%d-%H%M.jsonlz4")
        new.write_bytes(data)
        write_org(read_session(new), out / "tabs.org", source)
        snaps = sorted(out.glob("*.jsonlz4"))

    limit = time.time() - KEEP_DAYS * 86400
    for old in snaps[:-1]:
        if old.stat().st_mtime < limit:
            old.unlink()


def main():
    for profile in sorted(FIREFOX_DIR.glob("*/")):
        snapshot(profile)


if __name__ == "__main__":
    main()
