[Unit]
Description=Remove git worktrees whose PR is merged or closed

[Service]
Type=oneshot
# After a wake from suspend the network takes a few seconds to come back. Wait
# up to a minute for DNS, then run anyway.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts api.github.com >/dev/null && exit 0; sleep 2; done; exit 0'
# WT_GC_GLOBS lists the folders to scan, as shell globs (for example
# "/home/me/code/*/"). It lives in a machine-local file outside dotfiles. The
# shell expands the globs; wt-gc skips matches that are not git repos.
EnvironmentFile=%h/.config/wt-gc.env
# wt-gc-org puts the worktrees left behind into tasks.org or work.org.
ExecStart=/bin/bash -c 'set -o pipefail; %h/.local/bin/wt-gc --apply $$WT_GC_GLOBS | %h/.local/bin/wt-gc-org'
# Output goes to the journal: journalctl --user -u wt-gc
