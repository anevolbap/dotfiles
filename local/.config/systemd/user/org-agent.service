[Unit]
Description=Apply the triage proposals ticked in review-triage.org

[Service]
Type=oneshot
# Wait for a burst of saves to settle. Changes during the wait do not start a
# second run, since the unit is already active.
ExecStartPre=/bin/sleep 30
ExecStart=%h/.local/bin/org-agent-apply
# Output goes to the journal: journalctl --user -u org-agent
