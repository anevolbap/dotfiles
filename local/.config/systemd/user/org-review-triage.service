[Unit]
Description=Check REVIEW entries in tasks.org and write proposals to review-triage.org

[Service]
Type=oneshot
StateDirectory=org-review-triage
# After a wake from suspend the network takes a few seconds to come back. Wait
# up to a minute for DNS, then run anyway.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts api.anthropic.com >/dev/null && exit 0; sleep 2; done; exit 0'
ExecStart=%h/.local/bin/org-review-triage
StandardOutput=append:%S/org-review-triage/run.log
StandardError=append:%S/org-review-triage/run.log
