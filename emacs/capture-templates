(
 ;; --- Task ---
 ;; Captures go to the inbox undated. Add SCHEDULED/DEADLINE during review
 ;; with C-c C-s / C-c C-d from the entry. Also doubles as link capture: if
 ;; the clipboard holds a URL it's stored in :URL: automatically (`ao/org-
 ;; triage-links' sorts paper/video/reading list out later); %^g lets you tag
 ;; it right away if you already know, or just press RET to skip.
 ("t" "TODO" entry
      (file+headline "tasks.org" "Tasks to be reviewed")
      "* TODO %^{Title} %^g\n:PROPERTIES:\n:CAPTURED: %U\n:URL: %(or (ao/clipboard-url-or-nil) \"\")\n:END:\n\n%i%l%?"
      :empty-lines-after 1)

 ;; --- Meeting notes ---
 ("m" "Meeting notes" entry
      (file+headline "meetings.org" "Meetings")
      "* %^{Title} %t\n:PROPERTIES:\n:RELATED_PROJECT: %^{Project}\n:ATTENDEES: %^{Attendees}\n:END:\n\n%?"
      :prepend t :empty-lines-after 1)

 ;; --- Snippet / trick ---
 ("s" "Snippet / trick" entry
      (file+headline "snippets.org" "Snippets")
      "* %?\t%^g\n#+begin_src %^{language}\n\n#+end_src")

 ;; --- Event ---
 ("e" "Event" entry
      (file+headline "events.org" "Events")
      "* %^{Event Title}\n%^T\n%?"
      :empty-lines 1)

 )
