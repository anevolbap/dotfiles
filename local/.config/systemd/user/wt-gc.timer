[Unit]
Description=Remove worktrees of merged or closed PRs every day, and once after waking if a run was missed

[Timer]
OnCalendar=*-*-* 10:00:00
# A laptop asleep or off at that time skips the run. Persistent runs it once
# as soon as the machine is back.
Persistent=true

[Install]
WantedBy=timers.target
