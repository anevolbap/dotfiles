(
 ("e" "Event" entry
      (function (lambda () 
        (goto-char (point-min))
        (outline-next-heading)))
      "* %^{Event Title}\n:PROPERTIES:\n:DATE: %^T\n:END:\n%?"
      :empty-lines 1)
