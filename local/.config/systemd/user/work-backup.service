[Unit]
Description=Copy ~/Documents/work to Google Cloud Storage

[Service]
Type=oneshot
# After a wake from suspend the network takes a few seconds to come back. Wait
# up to a minute for DNS, then run anyway.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts storage.googleapis.com >/dev/null && exit 0; sleep 2; done; exit 0'
ExecStart=%h/.local/bin/work-backup
