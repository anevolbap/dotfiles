 ("m" "Memorandum of conversation" entry
	  (file+headline "meetings.org" "Meetings")
	  "* %t - %^{Title}\n SCHEDULED: %T\n:PROPERTIES:\n:RELATED_PROJECT: %^{Project}\n:ATTENDEES: %^{Attendees}\n:END:\n\n%?\n"
	  :empty-lines-after 1
	  :prepend t)
 ("s" "Code Snippet" entry
      (file+headline "snippets.org" "💾 Snippets")
      ;; Prompt for tag and language
      "* %?\t%^g\n#+begin_src %^{language}\n\n#+end_src")
 ("t" "Basic task for future review" entry
	  (file+headline "tasks.org" "Tasks to be reviewed")
	  "* %^{Title}\n:PROPERTIES:\n:CAPTURED: %U\n:END:\n\n%i%l%?\n"
	  :empty-lines-after 1)
 ("c" "Clock in to a task" entry
	  (file+headline "tasks.org" "Clocked tasks")
	  "* TODO %^{Title}\n SCHEDULED: %T\n :PROPERTIES:\n :EFFORT: %^{Effort estimate in inutes|5|10|15|30|45|60|90|120}\n :END:\n\n %a\n"
	  :prepend t
	  :clock-in t
	  :clock-keep t
	  :immediate-finish t
	  :empty-lines-after 1)
